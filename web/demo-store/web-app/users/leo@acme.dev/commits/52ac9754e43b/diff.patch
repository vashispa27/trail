+export function CheckoutButton({ cart }: { cart: Cart }) {
+  const [loading, setLoading] = useState(false);
+
+  async function submit() {
+    setLoading(true);
+    await placeOrder(cart);
+    setLoading(false);
+  }
+
+  return <button onClick={submit}>{loading ? <Spinner /> : "Place order"}</button>;
+}
