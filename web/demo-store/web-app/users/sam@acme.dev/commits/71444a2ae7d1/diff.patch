+export function ThemeToggle() {
+  const [pick, setPick] = useState<ThemeName | null>(() => localStorage.getItem("theme") as ThemeName | null);
+
+  useEffect(() => {
+    if (pick) document.documentElement.dataset.theme = pick;
+    else delete document.documentElement.dataset.theme; // follow the system
+  }, [pick]);
+
+  function toggle() {
+    const dark = pick ? pick === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
+    const next = dark ? "light" : "dark";
+    localStorage.setItem("theme", next);
+    setPick(next);
+  }
+
+  return <button onClick={toggle} aria-label="Toggle dark mode">◐</button>;
+}
