+++ b/app/webhooks.py
@@ -0,0 +1,9 @@
+from app.db import db
+from app.stripe import capture
+
+
+def handle_payment_succeeded(event):
+    order = db.orders.get(event["data"]["order_id"])
+    capture(order.payment_intent)
+    order.status = "paid"
+    db.orders.save(order)
