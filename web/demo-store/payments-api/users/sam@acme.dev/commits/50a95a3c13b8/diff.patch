new file mode 100644
index 0000000..b9e9744
--- /dev/null
+++ b/app/refunds.py
@@ -0,0 +1,9 @@
+from app.db import db
+from app.stripe import refund
+
+
+def create_refund(order_id, amount, agent):
+    order = db.orders.get(order_id)
+    refund(order.payment_intent, amount)
+    db.refunds.insert(order_id=order_id, amount=amount, agent=agent)
+    return {"ok": True}
